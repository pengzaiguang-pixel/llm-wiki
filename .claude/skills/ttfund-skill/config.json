{
  "name": "ttfund-skill",
  "version": "1.0.0",
  "description": "天天基金综合技能包 - 通过自然语言查询基金信息、基金经理、条件选基、基金持仓、黄金分析、投顾策略、指数详情、基金净值、模拟组合管理和自选基金等信息",
  "author": "LLM Wiki",
  "license": "MIT",
  "requirements": {
    "environment": [
      "TTFUND_APIKEY"
    ],
    "api_access": [
      "https://skills.tiantianfunds.com/ai-smart-skill-service/openapi/skill/invoke"
    ]
  },
  "features": [
    "fund_info_query",
    "fund_manager_query",
    "conditional_fund_selection",
    "fund_holding_query",
    "gold_analysis",
    "investment_advisory_query",
    "index_info_query",
    "nav_query",
    "portfolio_management",
    "favorite_fund_query"
  ],
  "api_mapping": {
    "FUND_BASE_INFOS": {
      "version": "1.1.0",
      "description": "基金基础信息查询"
    },
    "FUND_MANAGER_INFO": {
      "version": "1.0.0",
      "description": "基金经理信息查询"
    },
    "FUND_CONDITION_SELECT": {
      "version": "1.1.0",
      "description": "条件选基"
    },
    "FUND_HOLDING_INFO": {
      "version": "1.0.0",
      "description": "基金持仓查询"
    },
    "FUND_HUAAN_GOLD_INFO": {
      "version": "1.0.0",
      "description": "黄金行情分析"
    },
    "FUND_TG_STRATEGY_INFO": {
      "version": "1.0.0",
      "description": "投顾策略查询"
    },
    "FUND_INDEX_INFO": {
      "version": "1.0.0",
      "description": "指数详情查询"
    },
    "FUND_NAV_INFO": {
      "version": "1.0.0",
      "description": "基金净值查询"
    },
    "MODEL_PORTFOLIO": {
      "version": "1.0.0",
      "description": "模拟组合管理"
    },
    "FUND_FAVOR_ZX": {
      "version": "1.0.0",
      "description": "自选基金查询"
    }
  }
}